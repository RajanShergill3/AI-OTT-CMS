{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "AI OTT CMS — Auth",
    "description": "Authentication endpoints for the AI OTT CMS API.\n\n## Setup\n1. Import `postman/environments/local.postman_environment.json`\n2. Select the **Local** environment\n3. Run **Register** or **Login** first — test scripts auto-save `accessToken` and `refreshToken`\n4. Use **Profile** and **Logout** with the saved access token\n\n## Notes\n- Refresh token is also set as an `HttpOnly` cookie on register/login\n- **Refresh** can use the cookie (empty body) or `{{refreshToken}}` in the request body",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  if (json.success && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "    pm.environment.set('accessToken', json.data.accessToken);",
              "  }",
              "  const setCookie = pm.response.headers.get('Set-Cookie');",
              "  if (setCookie) {",
              "    const match = setCookie.match(/refreshToken=([^;]+)/);",
              "    if (match) {",
              "      pm.collectionVariables.set('refreshToken', match[1]);",
              "      pm.environment.set('refreshToken', match[1]);",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Editor\",\n  \"email\": \"editor@ottcms.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"EDITOR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "description": "Create a new user account and receive access + refresh tokens.\n\n**Role values:** `ADMIN`, `EDITOR`, `VIEWER` (optional, defaults to `VIEWER`)"
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.success && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "    pm.environment.set('accessToken', json.data.accessToken);",
              "  }",
              "  const setCookie = pm.response.headers.get('Set-Cookie');",
              "  if (setCookie) {",
              "    const match = setCookie.match(/refreshToken=([^;]+)/);",
              "    if (match) {",
              "      pm.collectionVariables.set('refreshToken', match[1]);",
              "      pm.environment.set('refreshToken', match[1]);",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"editor@ottcms.com\",\n  \"password\": \"SecurePass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Authenticate with email and password. Returns access token in body and refresh token as HttpOnly cookie."
      },
      "response": []
    },
    {
      "name": "Refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.success && json.data.accessToken) {",
              "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "    pm.environment.set('accessToken', json.data.accessToken);",
              "  }",
              "  const setCookie = pm.response.headers.get('Set-Cookie');",
              "  if (setCookie) {",
              "    const match = setCookie.match(/refreshToken=([^;]+)/);",
              "    if (match) {",
              "      pm.collectionVariables.set('refreshToken', match[1]);",
              "      pm.environment.set('refreshToken', match[1]);",
              "    }",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "description": "Exchange a refresh token for a new access token.\n\nUses `{{refreshToken}}` from login/register scripts. Alternatively send an empty body `{}` if Postman has the `refreshToken` cookie stored."
      },
      "response": []
    },
    {
      "name": "Logout",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "description": "End the current session. Requires Bearer access token. Clears refresh token cookie. Returns `204 No Content`."
      },
      "response": []
    },
    {
      "name": "Profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        },
        "description": "Get the authenticated user's profile. Requires Bearer access token from login or register."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ]
}
