# =============================================================================
# AI OTT CMS — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables below are REQUIRED — the server will not start if any are missing.
# =============================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ai-ott-cms

# JWT — access token
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# JWT — refresh token
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend client URL (used for CORS)
CLIENT_URL=http://localhost:5173

# =============================================================================
# Optional (defaults applied if omitted)
# =============================================================================

# API_PREFIX=/api/v1
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# LOG_LEVEL=debug
